+# ---------- Hebrew support (local patch) ----------
+# Any string containing Hebrew is drawn with a matching Hebrew font from fonts/he/.
+# Pillow's raqm layout (with fribidi) handles right-to-left order and mixed Hebrew/English/numbers.
+HEB_FONT = {k: os.path.join(ROOT, 'fonts', 'he', v) for k, v in {
+    'bold': 'Heebo-Black.ttf', 'anton': 'Heebo-ExtraBold.ttf', 'uib': 'Heebo-Black.ttf', 'montb': 'Heebo-ExtraBold.ttf',
+    'mont': 'Heebo-Bold.ttf', 'monts': 'Heebo-Bold.ttf', 'ui': 'Heebo-Medium.ttf', 'uim': 'Heebo-Regular.ttf',
+    'mono': 'Rubik-Medium.ttf', 'hand': 'Rubik-Bold.ttf',
+    'serif': 'DavidLibre-Medium.ttf', 'didone': 'DavidLibre-Medium.ttf', 'didoneb': 'DavidLibre-Bold.ttf', 'didonei': 'DavidLibre-Medium.ttf'}.items()}
+# Brand override: FX_HEB_FONT=birzia (or any family with <Family>-Black/-Bold/-Medium files in fonts/he/) swaps every Hebrew font.
+_fam = os.environ.get('FX_HEB_FONT', '').strip()
+if _fam:
+    _fam = _fam[:1].upper() + _fam[1:].lower()
+    def _pick_file(weight):
+        for ext in ('.ttf', '.otf', '.woff2', '.woff'):
+            p = os.path.join(ROOT, 'fonts', 'he', f'{_fam}-{weight}{ext}')
+            if os.path.exists(p): return p
+        return None
+    for _k in list(HEB_FONT):
+        _w = 'Black' if _k in ('bold', 'anton', 'uib', 'montb', 'didoneb') else 'Medium' if _k in ('ui', 'uim', 'serif', 'didone', 'didonei') else 'Bold'
+        _p = _pick_file(_w) or _pick_file('Bold') or _pick_file('Black')
+        if _p: HEB_FONT[_k] = _p
+def has_heb(s): return isinstance(s, str) and any('֐' <= ch <= '׿' for ch in s)
+
+
+class HebFallbackFont(ImageFont.FreeTypeFont):
+    """Behaves like the original font, but routes Hebrew strings to a Hebrew font."""
+    def __init__(self, path, size, heb_path):
+        super().__init__(path, size)
+        self._heb = ImageFont.truetype(heb_path, size) if heb_path and os.path.exists(heb_path) else None
+    def _pick(self, text): return self._heb if (self._heb is not None and has_heb(text)) else None
+    def getbbox(self, text, *a, **k):
+        h = self._pick(text); return h.getbbox(text, *a, **k) if h else super().getbbox(text, *a, **k)
+    def getlength(self, text, *a, **k):
+        h = self._pick(text); return h.getlength(text, *a, **k) if h else super().getlength(text, *a, **k)
+    def getmask(self, text, *a, **k):
+        h = self._pick(text); return h.getmask(text, *a, **k) if h else super().getmask(text, *a, **k)
+    def getmask2(self, text, *a, **k):
+        h = self._pick(text); return h.getmask2(text, *a, **k) if h else super().getmask2(text, *a, **k)
+
+
 _fc = {}
